<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/surfaceColorAlt"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab 1: Recents (Call History) -->
        <LinearLayout
            android:id="@+id/tabRecents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="?attr/surfaceColorAlt">

                <Button
                    android:id="@+id/filterAll"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="All"
                    android:textSize="12sp"
                    android:textColor="?attr/textSecondary"
                    android:background="@drawable/filter_btn_bg" />

                <Button
                    android:id="@+id/filterMissed"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="Missed"
                    android:textSize="12sp"
                    android:textColor="?attr/textSecondary"
                    android:background="@drawable/filter_btn_bg" />

                <Button
                    android:id="@+id/filterIncoming"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="Incoming"
                    android:textSize="12sp"
                    android:textColor="?attr/textSecondary"
                    android:background="@drawable/filter_btn_bg" />

                <Button
                    android:id="@+id/filterOutgoing"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="Outgoing"
                    android:textSize="12sp"
                    android:textColor="?attr/textSecondary"
                    android:background="@drawable/filter_btn_bg" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEmptyCalls"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="No call history\nGrant READ_CALL_LOG permission to see call logs"
                android:textColor="?attr/textMuted"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/callLogList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="64dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tab 2: Dialer -->
            <LinearLayout
                android:id="@+id/tabDialer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingHorizontal="24dp"
                android:paddingBottom="16dp">

                <!-- SIM selector -->
                <TextView
                    android:id="@+id/simSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:textSize="11sp"
                    android:textColor="?attr/textSecondary"
                    android:gravity="center"
                    android:background="@drawable/filter_btn_bg"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Number display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_bg"
                    android:padding="4dp"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/dialerNumber"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:textSize="30sp"
                        android:textColor="?attr/textPrimary"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:letterSpacing="0.12"
                        android:maxLines="1"
                        android:ellipsize="start"
                        android:hint="Enter number"
                        android:background="@android:color/transparent" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/dividerColor"
                        android:layout_marginTop="2dp" />

                    <!-- Backspace inline -->
                    <ImageButton
                        android:id="@+id/btnBackspace"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_backspace"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:contentDescription="Backspace"
                        android:layout_gravity="end"
                        android:tint="?attr/textMuted" />
                </LinearLayout>

                <!-- Dialer search results -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dialerSearchList"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:paddingHorizontal="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Row 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <Button android:id="@+id/btn1" style="@style/DialerButton" />
                    <Button android:id="@+id/btn2" style="@style/DialerButton" />
                    <Button android:id="@+id/btn3" style="@style/DialerButton" />
                </LinearLayout>
                <!-- Row 2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <Button android:id="@+id/btn4" style="@style/DialerButton" />
                    <Button android:id="@+id/btn5" style="@style/DialerButton" />
                    <Button android:id="@+id/btn6" style="@style/DialerButton" />
                </LinearLayout>
                <!-- Row 3 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <Button android:id="@+id/btn7" style="@style/DialerButton" />
                    <Button android:id="@+id/btn8" style="@style/DialerButton" />
                    <Button android:id="@+id/btn9" style="@style/DialerButton" />
                </LinearLayout>
                <!-- Row 4 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <Button android:id="@+id/btnStar" style="@style/DialerButton" />
                    <Button android:id="@+id/btn0" style="@style/DialerButton" />
                    <Button android:id="@+id/btnHash" style="@style/DialerButton" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/call_btn_bg">
                    <ImageButton
                        android:id="@+id/btnVoiceCall"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_call"
                        android:background="@android:color/transparent"
                        android:padding="18dp"
                        android:contentDescription="Voice Call"
                        android:scaleType="centerInside" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:gravity="center">
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/videocall_btn_bg"
                        android:layout_marginStart="16dp">
                        <ImageButton
                            android:id="@+id/btnVideoCall"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_videocam"
                            android:background="@android:color/transparent"
                            android:padding="10dp"
                            android:contentDescription="Video Call"
                            android:scaleType="centerInside" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Tab 3: Contacts -->
        <LinearLayout
            android:id="@+id/tabContacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/contactSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:queryHint="Search contacts..."
                android:background="?attr/surfaceColorAlt"
                android:padding="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contactList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="64dp" />
        </LinearLayout>

        <!-- Tab 4: Recordings (existing) -->
        <RelativeLayout
            android:id="@+id/tabRecordings"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No recordings yet"
                android:textColor="?attr/textMuted"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"
                android:layout_centerInParent="true" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="64dp" />

            <TextView
                android:id="@+id/tvCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Developed by Siva"
                android:textColor="?attr/textMuted"
                android:textSize="11sp"
                android:gravity="center"
                android:padding="6dp"
                android:layout_alignParentBottom="true" />
        </RelativeLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/dividerColor" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/surfaceColorAlt"
        android:elevation="8dp"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="?attr/textSecondary"
        app:itemTextColor="?attr/textSecondary"
        app:labelVisibilityMode="labeled" />
</LinearLayout>
